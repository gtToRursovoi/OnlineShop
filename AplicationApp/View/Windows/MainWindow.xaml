<Window x:Class="AplicationApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AplicationApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="650" Width="930"
        Background="Transparent">
    <Grid>
        <Image Source="/Assets/Image/Back1.jpg" Stretch="Fill" Panel.ZIndex="0">
            <Image.Effect>
                <BlurEffect Radius="10"/>
            </Image.Effect>
        </Image>
        <Rectangle Fill="#33000000" Panel.ZIndex="1"/>
        <Grid Panel.ZIndex="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="12*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Товары" Width="140" Margin="3" Background="Pink" Foreground="Black" Click="OpenProductClick"/>
                    <Button Content="Юзеры" Width="140" Margin="3" Background="Pink" Foreground="Black" Click="OpenUserClick"/>
                    <Button Content="Заказы" Width="140" Margin="3" Background="Pink" Foreground="Black" Click="OpenOrdersClick"/>
                    <Button Content="Выход" Width="140" Margin="340,0,0,0" Background="Pink" Foreground="Black" Click="ExitClick"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1">
                <Frame x:Name="MainFrame"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
