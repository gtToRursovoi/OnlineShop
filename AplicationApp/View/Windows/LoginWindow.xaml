<Window x:Class="AplicationApp.View.Windows.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AplicationApp.View.Windows"
        mc:Ignorable="d"
         Title="Авторизация" 
        Height="480" 
        Width="400"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <DropShadowEffect x:Key="ShadowEffect" 
                          BlurRadius="10" 
                          ShadowDepth="3" 
                          Color="#40000000" 
                          Opacity="0.2"/>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FFF5F5"/>
            <Setter Property="BorderBrush" Value="#E1BEE7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,5,0,15"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#FFF5F5"/>
            <Setter Property="BorderBrush" Value="#E1BEE7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,5,0,15"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#CE93D8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#BA68C8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#4A148C"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
    </Window.Resources>

    <Border Background="White" 
            CornerRadius="10" 
            BorderThickness="1" 
            BorderBrush="#E1BEE7"
            Effect="{StaticResource ShadowEffect}">

        <Grid>
            <!-- Фоновый градиент -->
            <Border  CornerRadius="10">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FFF5F5" Offset="0"/>
                        <GradientStop Color="#F3E5F5" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Основной контент -->
            <StackPanel Margin="40" VerticalAlignment="Center">
                <!-- Заголовок -->
                <TextBlock Text="Авторизация" 
                           FontSize="24" 
                           FontWeight="Bold" 
                           Foreground="#7B1FA2"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,30"/>

                <!-- Поля ввода -->
                <TextBlock Text="Имя пользователя"/>
                <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Пароль"/>
                <PasswordBox x:Name="PasswordBox" PasswordChanged="PasswordBox_PasswordChanged"/>

                <!-- Кнопки -->
                <Button Content="Войти" 
                        Command="{Binding LoginCommand}"
                        Background="#AB47BC"/>

                <Button Content="Регистрация" 
                        Click="OpenRegWindow"
                        Background="#9C27B0"/>

                <!-- Декоративный элемент -->
                <Border Height="1" Background="#E1BEE7" Margin="0,20"/>

                <TextBlock Text="Введите ваши данные" 
                           HorizontalAlignment="Center"
                           Foreground="#9E9E9E"
                           FontSize="12"/>
            </StackPanel>

           
        </Grid>
    </Border>
</Window>
