<Window x:Class="AplicationApp.View.Windows.RegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AplicationApp.View.Windows"
        mc:Ignorable="d"
         Title="Регистрация" 
        Height="650"
        Width="450"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <DropShadowEffect x:Key="ShadowEffect" 
                          BlurRadius="15" 
                          ShadowDepth="5" 
                          Color="#40000000" 
                          Opacity="0.3"/>
    </Window.Resources>

    <Border Background="Transparent"
            CornerRadius="15"
            BorderThickness="1"
            BorderBrush="Transparent"
            Effect="{StaticResource ShadowEffect}">

        <Grid ClipToBounds="True">
            <!-- 1. Фоновое изображение с размытием -->
            <Image Source="/Assets/Image/Back2.jpg" Stretch="Fill" Panel.ZIndex="0">
                <Image.Effect>
                    <BlurEffect Radius="10"/>
                </Image.Effect>
            </Image>

            <!-- 2. Затемнение -->
            <Rectangle Fill="#55FFFFFF" Panel.ZIndex="1"/>

            <!-- 3. Контент с градиентом и формой -->
            <Grid Panel.ZIndex="2">
               
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="40" VerticalAlignment="Center">
                        <TextBlock Text="Регистрация" 
                                   FontSize="24" 
                                   FontWeight="Bold" 
                                   Foreground="#7B1FA2"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,20"/>

                        <TextBlock Text="Имя пользователя"/>
                        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Email" Margin="10,0,0,0"/>
                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Width="350"/>

                        <TextBlock Text="Пароль"/>
                        <PasswordBox x:Name="PasswordBox" PasswordChanged="PasswordBox_PasswordChanged"/>

                        <TextBlock Text="Подтвердите пароль" Margin="0,20,0,0"/>
                        <PasswordBox x:Name="ConfirmBox" PasswordChanged="ConfirmBox_PasswordChanged"/>

                        <Button Content="Зарегистрироваться" 
                                Command="{Binding RegisterCommand}"
                                Background="#AB47BC"
                                Margin="0,20,0,10"/>

                        <Button Content="Уже есть аккаунт? Войти" 
                                Click="Button_Click"
                                Background="#9C27B0"/>

                        <Border Height="1" Background="#E1BEE7" Margin="0,20"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
