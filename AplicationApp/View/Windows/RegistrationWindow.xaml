<Window x:Class="AplicationApp.View.Windows.RegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AplicationApp.View.Windows"
        mc:Ignorable="d"
         Title="Регистрация" 
        Height="650"
        Width="450"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <DropShadowEffect x:Key="ShadowEffect" 
                          BlurRadius="15" 
                          ShadowDepth="5" 
                          Color="#40000000" 
                          Opacity="0.3"/>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FFF5F5"/>
            <Setter Property="BorderBrush" Value="#E1BEE7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,5,0,15"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="40"/>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#FFF5F5"/>
            <Setter Property="BorderBrush" Value="#E1BEE7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,5,0,15"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="40"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#CE93D8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="45"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#BA68C8"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#4A148C"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
    </Window.Resources>

    <Border Background="White" 
            CornerRadius="15" 
            BorderThickness="1" 
            BorderBrush="#E1BEE7"
            Effect="{StaticResource ShadowEffect}">

        <Grid>
            <!-- Фоновый градиент -->
            <Border  CornerRadius="15">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FFF5F5" Offset="0"/>
                        <GradientStop Color="#F3E5F5" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Основной контент -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="40" VerticalAlignment="Center">
                    <!-- Заголовок -->
                    <TextBlock Text="Регистрация" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="#7B1FA2"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>

                    <!-- Поля ввода -->
                    <TextBlock Text="Имя пользователя"/>
                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Email"/>
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Пароль"/>
                    <PasswordBox x:Name="PasswordBox" PasswordChanged="PasswordBox_PasswordChanged"/>

                    <TextBlock Text="Подтвердите пароль"/>
                    <PasswordBox x:Name="ConfirmBox" PasswordChanged="ConfirmBox_PasswordChanged"/>

                    <!-- Кнопки -->
                    <Button Content="Зарегистрироваться" 
                            Command="{Binding RegisterCommand}"
                            Background="#AB47BC"
                            Margin="0,20,0,10"/>

                    <Button Content="Уже есть аккаунт? Войти" 
                            Click="Button_Click"
                            Background="#9C27B0"/>

                    <!-- Декоративный элемент -->
                    <Border Height="1" Background="#E1BEE7" Margin="0,20"/>
                </StackPanel>
            </ScrollViewer>

          
        </Grid>
    </Border>
</Window>
